[13:48:45] $ cat ../roles/python311/defaults/main.yml
---
# Role python311: cài hoặc cập nhật Python 3.11 từ mã nguồn (make altinstall vào /usr/local).
# Chỉ build khi phiên bản đang cài khác python311_version, nên chạy lại bao nhiêu lần cũng không đổi gì.
python311_version: "3.11.18"
# SHA-256 của file .tgz, lấy từ trang python.org/downloads/release/python-311XX/
python311_sha256:
  "3.11.17": 53cdee63ac4bf12387b7b33a53d3b1f8f4941cad73807a7b4fe91bb001ef004a
  "3.11.18": 5f62711b12470fd435f83f1451c1b1ef4a179aebc715c716874b0967567d814e
python311_prefix: /usr/local
python311_build_dir: /usr/local/src
# Production nên thêm --enable-optimizations --with-lto (build lâu hơn nhiều, Python nhanh hơn ~10-20%)
python311_configure_args: "--prefix={{ python311_prefix }}"
python311_build_deps:
  - gcc
  - make
  - tar
  - openssl-devel
  - bzip2-devel
  - libffi-devel
  - zlib-devel
  - xz-devel
  - sqlite-devel
  - readline-devel
  - ncurses-devel
  - gdbm-devel
  - libuuid-devel
  - tk-devel

[13:48:45] $ cat ../roles/python311/tasks/main.yml
---
- name: Đọc phiên bản python3.11 đang cài
  ansible.builtin.command: "{{ python311_prefix }}/bin/python3.11 -c 'import platform; print(platform.python_version())'"
  register: python311_current
  changed_when: false
  failed_when: false

- name: Ghi nhận phiên bản hiện tại
  ansible.builtin.set_fact:
    python311_installed: "{{ python311_current.stdout if python311_current.rc == 0 else 'chưa cài' }}"
    python311_src: "{{ python311_build_dir }}/Python-{{ python311_version }}"

- name: So sánh với phiên bản mục tiêu
  ansible.builtin.debug:
    msg: "python3.11 đang cài: {{ python311_installed }} | mục tiêu: {{ python311_version }} | cần build: {{ python311_installed != python311_version }}"

- name: Build và cài Python {{ python311_version }} (chỉ khi khác phiên bản đang cài)
  when: python311_installed != python311_version
  block:
    - name: Cài công cụ build và thư viện -devel (gdbm-devel ở kho CRB)
      ansible.builtin.dnf:
        name: "{{ python311_build_deps }}"
        enablerepo: crb
        state: present

    - name: Tải mã nguồn và kiểm tra SHA-256
      ansible.builtin.get_url:
        url: "https://www.python.org/ftp/python/{{ python311_version }}/Python-{{ python311_version }}.tgz"
        dest: "{{ python311_build_dir }}/Python-{{ python311_version }}.tgz"
        checksum: "sha256:{{ python311_sha256[python311_version] }}"
        mode: "0644"

    - name: Giải nén mã nguồn
      ansible.builtin.unarchive:
        src: "{{ python311_build_dir }}/Python-{{ python311_version }}.tgz"
        dest: "{{ python311_build_dir }}"
        remote_src: true
        creates: "{{ python311_src }}/configure"

    - name: configure
      ansible.builtin.command:
        cmd: "./configure {{ python311_configure_args }}"
        chdir: "{{ python311_src }}"
        creates: "{{ python311_src }}/Makefile"

    - name: make (chạy nền, kiểm tra mỗi 15 giây, tối đa 1 giờ)
      ansible.builtin.command:
        cmd: "make -j{{ ansible_facts['processor_vcpus'] }}"
        chdir: "{{ python311_src }}"
        creates: "{{ python311_src }}/python"
      async: 3600
      poll: 15

    - name: make altinstall (không ghi đè python3 của hệ thống)
      ansible.builtin.command:
        cmd: make altinstall
        chdir: "{{ python311_src }}"
      changed_when: true

    - name: Dọn thư mục build
      ansible.builtin.file:
        path: "{{ item }}"
        state: absent
      loop:
        - "{{ python311_src }}"
        - "{{ python311_src }}.tgz"

- name: Kiểm tra lại phiên bản sau khi chạy role
  ansible.builtin.command: "{{ python311_prefix }}/bin/python3.11 -c 'import platform, ssl; print(platform.python_version(), ssl.OPENSSL_VERSION)'"
  register: python311_after
  changed_when: false

- name: Xác nhận đúng phiên bản mục tiêu
  ansible.builtin.assert:
    that: python311_after.stdout.split()[0] == python311_version
    success_msg: "python3.11 = {{ python311_after.stdout }}"
    fail_msg: "python3.11 = {{ python311_after.stdout }}, khác mục tiêu {{ python311_version }}"

[13:48:45] $ cat playbook.yaml
---
# Bài 9 (Phần 3): cập nhật Python 3.11 trên máy chủ bằng Ansible, đảm bảo idempotent.
# Máy đang có 3.11.17 (Bài 4) -> playbook đưa lên 3.11.18. Chạy lại lần nữa thì không build lại (changed=0).
# Đổi phiên bản mục tiêu: ansible-playbook playbook.yaml -e python311_version=3.11.18
- name: Cập nhật Python 3.11 lên bản bảo trì mới nhất
  hosts: python_servers
  become: true
  roles:
    - python311

  post_tasks:
    - name: Virtualenv tạo từ trước (Bài 4) vẫn chạy được với bản vá mới
      ansible.builtin.command: >-
        {{ venv_path }}/bin/python -c
        "import sys, requests; print(sys.version.split()[0], 'requests', requests.__version__)"
      vars:
        venv_path: "/home/{{ ansible_facts['env']['SUDO_USER'] | default('rocky') }}/py311-venv"
      become: false
      register: venv_check
      changed_when: false
      failed_when: false

    - name: Kết quả
      ansible.builtin.debug:
        msg:
          - "python3.11 hệ thống: {{ python311_after.stdout }}"
          - "venv ~/py311-venv: {{ venv_check.stdout | default('không có venv') }}"

