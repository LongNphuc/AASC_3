================================================================
== 1. Trạng thái trước khi đổi: chỉ có user default dùng requirepass
================================================================

[13:28:17] $ as_default ACL LIST | mask
user default on sanitize-payload #d748a03c9a6f9904ff35f50c700bc297f265899b96919788e28511466d38289f ~* &* +@all

[13:28:17] $ sudo grep -nE '^(requirepass|aclfile) ' /etc/redis/redis.conf | mask
2295:requirepass "<REDACTED>"

================================================================
== 2. Chuyển sang file ACL
================================================================
File ACL ban đầu chỉ chứa user default với mã băm SHA-256 của mật khẩu hiện tại,
để Redis vẫn được bảo vệ ngay khi khởi động lại với file ACL.

[13:28:17] $ echo 'user default on #d748a03c9a6f9904ff35f50c700bc297f265899b96919788e28511466d38289f ~* &* +@all' | sudo install -o redis -g root -m 640 /dev/stdin /etc/redis/users.acl

[13:28:17] $ sudo restorecon -v /etc/redis/users.acl

[13:28:17] $ sudo sed -i -E 's/^requirepass .*/# requirepass: đã chuyển sang aclfile (Bài 3)/' /etc/redis/redis.conf
CONFIG REWRITE (Bài 2) có ghi user default vào redis.conf; phải xóa dòng 'user ...' vì Redis
không cho khai báo user ở cả redis.conf lẫn aclfile.

[13:28:17] $ sudo sed -i -E '/^user /d' /etc/redis/redis.conf

[13:28:17] $ echo 'aclfile /etc/redis/users.acl' | sudo tee -a /etc/redis/redis.conf
aclfile /etc/redis/users.acl

[13:28:17] $ sudo grep -nE '^(# requirepass|requirepass|user|aclfile) ' /etc/redis/redis.conf || true
1044:# requirepass foobared
2304:aclfile /etc/redis/users.acl

[13:28:17] $ sudo systemctl restart redis

[13:28:19] $ as_default ACL LIST
user default on sanitize-payload #d748a03c9a6f9904ff35f50c700bc297f265899b96919788e28511466d38289f ~* &* +@all

================================================================
== 3. Tạo user admin, app, reader
================================================================

[13:28:19] $ as_default ACL SETUSER admin on ">$ADMIN_PASS" "~*" "&*" +@all
OK

[13:28:19] $ as_default ACL SETUSER app on ">$APP_PASS" "~*" "&*" +@all -@dangerous -@scripting
OK

[13:28:19] $ as_default ACL SETUSER reader on ">$READER_PASS" "~*" resetchannels -@all +@read +@connection -@dangerous "+acl|whoami"
OK

[13:28:19] $ as_admin ACL WHOAMI
admin

================================================================
== 4. Tắt user default (từ giờ phải đăng nhập bằng user có tên)
================================================================

[13:28:19] $ as_admin ACL SETUSER default off
OK

[13:28:19] $ as_default ping
AUTH failed: WRONGPASS invalid username-password pair or user is disabled.
NOAUTH Authentication required.


[13:28:19] $ env -u REDISCLI_AUTH redis-cli ping
NOAUTH Authentication required.


