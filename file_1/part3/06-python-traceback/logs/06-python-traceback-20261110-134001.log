================================================================
== 1. Mã nguồn script.py
================================================================

[13:40:02] $ cat -n script.py
     1	"""Bài 6 (Phần 3): ZeroDivisionError nằm trong biểu thức lồng nhau, để so sánh traceback giữa Python 3.9 và 3.11.
     2	
     3	Doanh thu trung bình mỗi ngày của một tháng = (tổng doanh thu / số đơn vị) / số ngày bán hàng * hệ số thuế.
     4	Dữ liệu tháng 3 có số ngày bán hàng bằng 0, nên một trong ba phép chia trên cùng một dòng sẽ lỗi.
     5	Python 3.9 chỉ báo số dòng; Python 3.11 đánh dấu đúng phép chia gây lỗi (PEP 657).
     6	"""
     7	
     8	BAO_CAO = {
     9	    "thang": "T3",
    10	    "doanh_thu": [120_000_000, 95_000_000, 143_000_000],
    11	    "don_vi": 3,
    12	    "so_ngay_ban": {"T1": 26, "T2": 24, "T3": 0},
    13	    "thue": 10,
    14	}
    15	
    16	
    17	def doanh_thu_trung_binh_ngay(bc):
    18	    return round((sum(bc["doanh_thu"]) / bc["don_vi"]) / bc["so_ngay_ban"][bc["thang"]] * (1 + bc["thue"] / 100), 2)
    19	
    20	
    21	def lap_bao_cao(bc):
    22	    return {"thang": bc["thang"], "trung_binh_ngay": doanh_thu_trung_binh_ngay(bc)}
    23	
    24	
    25	def main():
    26	    try:
    27	        print(lap_bao_cao(BAO_CAO))
    28	    except ZeroDivisionError as e:
    29	        if hasattr(e, "add_note"):  # PEP 678, có từ Python 3.11
    30	            e.add_note(f"Gợi ý: kiểm tra so_ngay_ban của tháng {BAO_CAO['thang']} trong dữ liệu đầu vào")
    31	        raise
    32	
    33	
    34	if __name__ == "__main__":
    35	    main()

